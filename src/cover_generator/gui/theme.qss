/* Modern flat theme, layered on top of the Qt Fusion style. */

QMainWindow, QWidget {
    background-color: #fafafa;
    color: #212121;
    font-size: 13px;
}

QPushButton {
    background-color: #e0e0e0;
    border: 1px solid #bdbdbd;
    border-radius: 6px;
    padding: 6px 14px;
}

QPushButton:hover {
    background-color: #d5d5d5;
}

QPushButton:pressed {
    background-color: #c2c2c2;
}

QPushButton#generateButton {
    background-color: #1976d2;
    color: white;
    border: none;
    font-weight: 600;
}

QPushButton#generateButton:hover {
    background-color: #1565c0;
}

QPushButton#generateButton:disabled, QPushButton:disabled {
    background-color: #eeeeee;
    color: #9e9e9e;
}

QFrame#imagePicker {
    background-color: white;
    border: 1px solid #e0e0e0;
    border-radius: 8px;
    padding: 8px;
}

QLabel#imagePickerTitle {
    font-weight: 600;
}

QLabel#imagePickerThumbnail {
    background-color: #f5f5f5;
    border: 1px dashed #bdbdbd;
    border-radius: 6px;
    color: #9e9e9e;
}

QLineEdit, QSpinBox, QDoubleSpinBox, QComboBox {
    background-color: white;
    border: 1px solid #bdbdbd;
    border-radius: 4px;
    padding: 3px 6px;
}

QProgressBar {
    border: 1px solid #bdbdbd;
    border-radius: 4px;
    text-align: center;
}

QProgressBar::chunk {
    background-color: #1976d2;
    border-radius: 4px;
}
